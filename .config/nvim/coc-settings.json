{
  "diagnostic.errorSign": "⁉️",
  "diagnostic.warningSign": "⚠️",
  "diagnostic.infoSign": ">",
  "diagnostic.hintSign": ">",

  "diagnostic.messageTarget": "float",
  "diagnostic.autoRefresh": true,
  "diagnostic.checkCurrentLine": true,
  "diagnostic.displayByAle": true,

  "python.venvPath": ".venv",

  "python.linting.enabled": false,
  "python.linting.flake8Enabled": false,
  "python.linting.ruffEnabled": true,
  "python.linting.banditEnabled": false,
  "python.linting.pyflakesEnabled": false,
  "python.linting.pylintEnabled": false,
  "pyright.inlayHints.parameterTypes": false,
  "pyright.inlayHints.variableTypes": false,
  "suggest.noselect": true,
  "pyright.disableDiagnostics": true,
  "clangd.path": "~/.config/coc/extensions/coc-clangd-data/install/19.1.2/clangd_19.1.2/bin/clangd"
}
