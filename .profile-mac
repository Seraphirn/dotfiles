#!/bin/zsh
#
# Default programs:
#
export TERMINAL="open -a Terminal ~"
#export TERMINAL="st"
export EDITOR="nvim"
export BROWSER="firefox"

# set PATH so it includes user's private bin if it exists
if [ -d "/usr/local/opt/python/libexec/bin" ] ; then
    PATH="/usr/local/opt/python/libexec/bin:$PATH"
fi
